{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/secrets/**)",
      "Read(**/*.secret)",
      "Read(//etc/mjk/secrets/**)",
      "Read(//etc/rws/secrets/**)",
      "Read(//etc/f1/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * -d)",
      "Bash(git push * :*)",
      "Bash(git * push -f*)",
      "Bash(git * push * -f*)",
      "Bash(git * push --force*)",
      "Bash(git * push * --force*)",
      "Bash(git * push +*)",
      "Bash(git * push * +*)",
      "Bash(git * push *--mirror*)",
      "Bash(git * push *--delete*)",
      "Bash(git send-pack*)",
      "Bash(git * send-pack*)",
      "Bash(git *--output*)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push * *:refs/heads/main*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push * main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push * 'main'*)",
      "Bash(git push * \"main\"*)",
      "Bash(git * push * main)",
      "Bash(git * push * main *)",
      "Bash(git * push *:main*)",
      "Bash(gh pr merge*)",
      "Bash(gh * pr merge*)",
      "Bash(gh api*)",
      "Bash(gh * api*)",
      "Bash(gh auth*)",
      "Bash(gh * auth*)",
      "Bash(gh alias*)",
      "Bash(gh * alias*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret*)",
      "Bash(pnpm dlx*)",
      "Bash(pnpm exec*)",
      "Bash(pnpm * dlx*)",
      "Bash(pnpm * exec*)",
      "Bash(pnpx*)",
      "Bash(npx*)",
      "Bash(npm)",
      "Bash(npm *)",
      "Bash(yarn)",
      "Bash(yarn *)",
      "Bash(bun)",
      "Bash(bun *)",
      "Bash(bunx *)"
    ],
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm test:integration)",
      "Bash(pnpm i18n)",
      "Bash(pnpm test:e2e)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)"
    ]
  }
}
