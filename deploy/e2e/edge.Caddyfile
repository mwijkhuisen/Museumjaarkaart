# CI only: stands in for Cloudflare's edge and cloudflared (TLS for mjk.test and admin.mjk.test,
# X-Forwarded-Proto), at cloudflared's fixed 10.63.6.10. Like Cloudflare, it appends the address it saw to
# any X-Forwarded-For the visitor sent (every peer here is in a private range), so the Caddy cases can
# prove that caddy takes the right-most entry, never a forged one.
{
	admin off
	skip_install_trust
	auto_https disable_redirects
	servers {
		protocols h1 h2
		trusted_proxies static private_ranges
	}
}

mjk.test, admin.mjk.test {
	tls internal
	header -Server
	# CI only (cookie.spec.ts): proves both engines keep a __Host- Secure HttpOnly cookie on https.
	handle /__e2e/cookie/set {
		header Set-Cookie "__Host-mjk_probe=1; Path=/; Secure; HttpOnly; SameSite=Lax"
		respond "set" 200
	}
	handle /__e2e/cookie/echo {
		respond "{http.request.header.Cookie}" 200
	}
	handle {
		reverse_proxy caddy:80 {
			header_up X-Forwarded-Proto https
		}
	}
}

# R2's custom domain for the media bucket (A§12, A§15.3), in front of the MinIO stand-in: the bucket's objects at the
# root (/tiles/x is mjk-media/tiles/x), GET and HEAD only, Range passed through (206). R2's CORS rule replaces MinIO's
# own (A2: allowed origin https://mjk.test only, GET and HEAD, header `range`, exposed `ETag`), and the Transform
# Rule's headers sit on every answer. The same rule goes into the bucket by hand (docs/runbooks/tiles-refresh.md).
media.mjk.test {
	tls internal
	header {
		-Server
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'none'; sandbox"
		Vary Origin
	}
	@preflight {
		method OPTIONS
		header Origin https://mjk.test
	}
	handle @preflight {
		header {
			Access-Control-Allow-Origin https://mjk.test
			Access-Control-Allow-Methods "GET, HEAD"
			Access-Control-Allow-Headers range
			Access-Control-Max-Age 3600
		}
		respond 204
	}
	@read method GET HEAD
	handle @read {
		@cors header Origin https://mjk.test
		header @cors {
			Access-Control-Allow-Origin https://mjk.test
			Access-Control-Expose-Headers ETag
		}
		rewrite * /mjk-media{uri}
		reverse_proxy minio:9000 {
			# MinIO answers CORS and Vary itself when it sees an Origin: it never does here.
			header_up -Origin
			header_up Host {upstream_hostport}
			header_down -Access-Control-*
			header_down -Vary
		}
	}
	handle {
		respond 403
	}
}

# The two outside names the api and the worker dial (P2a), answered under the throw-away CA that stack.sh makes
# (compose.yaml gives `api` and `worker` its file in NODE_EXTRA_CA_CERTS): Cloudflare Access's certs for
# CF_ACCESS_TEAM=test-team (deploy/e2e/access-stub.mjs wrote the file), and Lettermint's send API in front of the
# mail sink. The production code dials the real URLs unchanged.
test-team.cloudflareaccess.com {
	tls /pki/test-team.cloudflareaccess.com.pem /pki/test-team.cloudflareaccess.com.key
	handle /cdn-cgi/access/certs {
		root * /pki
		rewrite * /jwks.json
		file_server
	}
	handle {
		respond 404
	}
}

api.lettermint.co {
	tls /pki/api.lettermint.co.pem /pki/api.lettermint.co.key
	reverse_proxy mailsink:8025
}

# R2's S3 API for the worker's media_publish and media_delete (P3b): MJK_R2_ENDPOINT=https://r2.mjk.test, under the
# throw-away CA, in front of the MinIO stand-in. The Host header passes unchanged (SigV4 signs it); the
# X-Forwarded-* headers Caddy would add are dropped, so MinIO checks the request exactly as the worker signed it.
r2.mjk.test {
	tls /pki/r2.mjk.test.pem /pki/r2.mjk.test.key
	reverse_proxy minio:9000 {
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
	}
}

# A visitor on plain http, as Cloudflare forwards it without "Always Use HTTPS": caddy answers with the 308.
http://mjk.test, http://admin.mjk.test {
	reverse_proxy caddy:80 {
		header_up X-Forwarded-Proto http
	}
}
