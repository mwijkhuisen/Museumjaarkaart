#!/usr/sbin/nft -f
# table inet mjk: the egress firewall of the mjk stack (A§17.4, ADR-0003).
#
# Loaded by mjk-firewall.service (nft -c, then nft -f) from the root-owned copy /etc/mjk/mjk.nft, and
# reloaded by mjk-tick when it is missing. This file touches only `table inet mjk`: it never empties
# the whole ruleset (that would delete Docker's tables, Waterheight's `inet rws` and F1's `inet f1`),
# and deploy/tests/nft-check.sh fails on any other table or on such a statement under deploy/.
#
# Atomic and idempotent: the three statements below run as one transaction. The first declares the
# table (a no-op when it exists), the second deletes it, the third defines it again. A reload therefore
# empties the sets resolvers4 and worker_dst4 too: mjk-firewall.service runs mjk-resolvers and
# mjk-egress.service runs mjk-egress right after, and mjk-tick runs both.
#
# Only interfaces named mjk-* are filtered (A§17.3 names every bridge mjk-*). The networks are told
# apart by their fixed A§17.3 subnets, so this file does not depend on the exact bridge names:
#   10.63.1.0/24 mjk-db             internal       no egress
#   10.63.2.0/24 mjk-edge           internal       no egress
#   10.63.3.0/24 mjk-egress         worker         DNS, tcp/443 to cf4 (R2) and worker_dst4 (the named hosts)
#   10.63.4.0/24 mjk-api-egress     api            DNS, tcp/443 to cf4 (the Access certs)
#   10.63.5.0/24 mjk-tunnel         cloudflared    DNS, tcp+udp/7844 to cf_tunnel4
#   10.63.6.0/24 mjk-tunnel-edge    internal       no egress
#   10.63.7.0/24 mjk-publish        caddy          no egress (carries the 127.0.0.1:8280 publish)
#   10.63.8.0/24 mjk-backup-egress  backup         DNS, tcp/443 to cf4 (R2)
# Containers run with cap_drop: ALL, so they cannot forge a source address from another subnet.
#
# Chains of several base chains on one hook all see a packet: an `accept` here only ends this table's
# verdict and hands the packet on to Docker's own chains (priority filter); a `drop` is final. So the
# policy is accept (other projects' traffic is not ours to judge) and every mjk-* path ends in a drop.

table inet mjk
delete table inet mjk

table inet mjk {
	# Cloudflare's published IPv4 ranges (https://www.cloudflare.com/ips-v4). Written from the list as
	# known to the build agent on 2026-11-21, not fetched (agents never call Cloudflare): the owner
	# checks it on the box against the live list and refreshes it by hand (docs/runbooks/cloudflare.md).
	set cf4 {
		type ipv4_addr
		flags interval
		elements = {
			103.21.244.0/22,
			103.22.200.0/22,
			103.31.4.0/22,
			104.16.0.0/13,
			104.24.0.0/14,
			108.162.192.0/18,
			131.0.72.0/22,
			141.101.64.0/18,
			162.158.0.0/15,
			172.64.0.0/13,
			173.245.48.0/20,
			188.114.96.0/20,
			190.93.240.0/20,
			197.234.240.0/22,
			198.41.128.0/17,
		}
	}

	# The tunnel's edge ranges (A§17.4, Cloudflare's "Tunnel with firewall" page); refreshed by hand.
	set cf_tunnel4 {
		type ipv4_addr
		flags interval
		elements = { 198.41.192.0/24, 198.41.200.0/24 }
	}

	# The host's DNS resolvers, filled by mjk-resolvers from resolv.conf at start and on every mjk-tick.
	# Empty after a load until mjk-resolvers runs: no DNS in between (fail closed).
	set resolvers4 {
		type ipv4_addr
	}

	# The addresses of the hosts the worker dials outside Cloudflare (/etc/mjk/egress-hosts), filled by
	# mjk-egress from the host's resolver at start and on every mjk-tick. Empty after a load until
	# mjk-egress runs: the worker then reaches only cf4 (fail closed).
	set worker_dst4 {
		type ipv4_addr
	}

	# Never reachable from a container, not even on 443: this-network, private, CGNAT, loopback,
	# link-local, IETF protocol assignments, documentation, benchmarking, multicast, reserved, broadcast.
	set private4 {
		type ipv4_addr
		flags interval
		elements = {
			0.0.0.0/8,
			10.0.0.0/8,
			100.64.0.0/10,
			127.0.0.0/8,
			169.254.0.0/16,
			172.16.0.0/12,
			192.0.0.0/24,
			192.0.2.0/24,
			192.168.0.0/16,
			198.18.0.0/15,
			198.51.100.0/24,
			203.0.113.0/24,
			224.0.0.0/4,
			240.0.0.0/4,
		}
	}

	# The four non-internal networks that may resolve names (A§17.4); mjk-publish is not among them.
	set dns_nets4 {
		type ipv4_addr
		flags interval
		elements = { 10.63.3.0/24, 10.63.4.0/24, 10.63.5.0/24, 10.63.8.0/24 }
	}

	# Published ports are DNATed in nat PREROUTING and never reach INPUT, so egress is judged here.
	chain forward {
		type filter hook forward priority filter - 10; policy accept;

		iifname "mjk-*" oifname "mjk-*" accept comment "between two mjk bridges: Docker's own rules decide"
		iifname "mjk-*" goto egress
		oifname "mjk-*" goto ingress
	}

	# A packet that leaves an mjk-* bridge for any other interface.
	chain egress {
		meta nfproto ipv6 counter drop comment "the mjk networks are IPv4 only"
		ip saddr != 10.63.0.0/16 counter drop comment "not from an mjk subnet"

		# DNS before the private-range drop: the resolvers may sit on the LAN.
		ip saddr @dns_nets4 ip daddr @resolvers4 meta l4proto { tcp, udp } th dport 53 accept

		ip daddr @private4 counter drop comment "private, link-local and CGNAT ranges, even on 443"

		ip saddr 10.63.3.0/24 ip daddr @cf4 tcp dport 443 accept comment "mjk-egress (worker): R2 and other Cloudflare-fronted hosts"
		ip saddr 10.63.3.0/24 ip daddr @worker_dst4 tcp dport 443 accept comment "mjk-egress (worker): the hosts of egress-hosts"
		ip saddr 10.63.4.0/24 ip daddr @cf4 tcp dport 443 accept comment "mjk-api-egress (api): Cloudflare only"
		ip saddr 10.63.8.0/24 ip daddr @cf4 tcp dport 443 accept comment "mjk-backup-egress (backup): R2"
		ip saddr 10.63.5.0/24 ip daddr @cf_tunnel4 meta l4proto { tcp, udp } th dport 7844 accept comment "mjk-tunnel (cloudflared)"

		counter drop comment "everything else, all of mjk-publish and the internal networks included"
	}

	# A packet from any other interface into an mjk-* bridge: only replies to the egress above.
	chain ingress {
		ct state established,related accept
		counter drop comment "no new connection into an mjk network"
	}

	# The host itself: only replies pass from an mjk-* bridge (docker-proxy's path for 127.0.0.1:8280).
	chain input {
		type filter hook input priority filter - 10; policy accept;

		iifname "mjk-*" ct state established,related accept
		iifname "mjk-*" counter drop comment "containers never open a connection to the host"
	}
}
