#!/usr/bin/env bash
# mjk-update: pull the desired images, migrate, bring the stack up, smoke-test it, and roll back
# when anything fails (A§17.5). Run by mjk-update.timer (every 10 minutes) from the root-owned copy
# /usr/local/bin/mjk-update, never from a checkout; or by hand to deploy given images:
#   mjk-update                                     the :main images of ghcr.io/mwijkhuisen/mjk-{server,web,backup}
#   mjk-update --server <ref> --web <ref> [--backup <ref>]
#                                                  exactly these images (drills, CI). A ref that is left out
#                                                  keeps its image from current.env (else :main).
# Files (A§17.1), all under /srv/mjk/state:
#   current.env   the three MJK_*_IMAGE refs of the last good deploy and MJK_COMPOSE_SHA256, the sha256 of
#                 the compose file(s) it was deployed with; replaced only after a success
#   failed.env    the same four values of the last failed deploy; the automatic run refuses that same set
#                 until `rm /srv/mjk/state/failed.env` (a new image or a changed compose file is a new set)
# Steps (A§17.5):
#   1. flock /run/mjk/deploy.lock exclusive, non-blocking (mjk-tick and mjk-backup.service take it
#      shared): held -> exit 0; table inet mjk not loaded -> exit 1 (checked again before each compose step). A leftover firewall-stopped marker (mjk-tick
#      stopped the stack because the table could not load) is cleared by starting current.env again.
#   2. pull; record each ref by digest (a ref with a registry host is recorded as repo@sha256:..., never
#      as a tag); the automatic run waits (exit 0) while the three images' org.opencontainers.image.revision
#      labels differ, and stops when the digests and the compose sha256 equal current.env or the set
#      equals failed.env. A compose change alone (mjk-install copied a new compose.yaml) is deployed with
#      the same images, through the same steps.
#   3. migrate (profile jobs), 4. up -d, 5. every daemon healthy within 180 s, then the smoke test with
#      Host: <domain> on http://127.0.0.1:8280 (/api/v1/healthz, /, /musea and one museum if there is one).
#   6. on a failure: write failed.env, put current.env's images back and wait until they are healthy;
#      without a current.env, stop the stack. Exit 1. A rollback never runs a migration down: a migration
#      must work with the previous image (expand now, contract later). It cannot put an older compose
#      file back: after a failed compose change, fix the file and run mjk-install again.
#   7. after a success: remove the local images of ghcr.io/mwijkhuisen/mjk-* that current.env does not
#      use (by reference: never another project's image).
# Each docker step is bounded (a fail-closed restart 600 s, pull 300 s per image, migrate 300 s, up 600 s,
# health 180 s, smoke 50 s, the rollback's up 600 s and health 180 s): about 57 minutes at most, under
# the unit's TimeoutStartSec=65min. On a
# failed compose step the last lines of its error output are logged (compose names files, services and
# image refs there; it never prints a secret file's content).
# It logs image refs, digests, container names, compose's error lines and fixed messages; never an
# environment, a secret or a response body. Exit 0 done or nothing to do · 1 failed or refused · 64 usage · 78 config.
# MJK_ROOT (a directory) moves every host path below it and lets MJK_NFT stand in for nft; only
# deploy/tests/e2e.sh sets it. The units never do.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 0022

ROOT=${MJK_ROOT:-}
if [[ -n $ROOT ]]; then
  [[ $ROOT == /* && $ROOT != */ ]] || { echo "mjk-update: MJK_ROOT must be an absolute path without a trailing slash" >&2; exit 78; }
fi
ETC=$ROOT/etc/mjk
STATE=$ROOT/srv/mjk/state
LOCKDIR=$ROOT/run/mjk
LOCKFILE=$LOCKDIR/deploy.lock
COMPOSE=$ETC/compose.yaml
MJK_ENV=$ETC/mjk.env
CURRENT=$STATE/current.env
FAILED=$STATE/failed.env
NEXT=$STATE/next.env
MARKER=$STATE/firewall-stopped
NFT=nft
OVERRIDE=
if [[ -n $ROOT ]]; then
  NFT=${MJK_NFT:-nft}
  [[ ! -f $ETC/compose.override.yaml ]] || OVERRIDE=$ETC/compose.override.yaml
fi

REPO_PREFIX=ghcr.io/mwijkhuisen
REVISION_LABEL=org.opencontainers.image.revision
WAIT_SECONDS=180
SMOKE_PORT=8280
VARS=(MJK_SERVER_IMAGE MJK_WEB_IMAGE MJK_BACKUP_IMAGE)
OWN_IMAGES="$REPO_PREFIX/mjk-*"

log() { printf 'mjk-update: %s\n' "$*"; }
die() {
  printf 'mjk-update: %s\n' "$1" >&2
  exit "${2:-1}"
}

usage() {
  echo "usage: mjk-update [--server <ref>] [--web <ref>] [--backup <ref>]" >&2
  exit 64
}

# --- arguments ---------------------------------------------------------------------------------------
explicit=0
declare -A given=()
while (($# > 0)); do
  case $1 in
    --server | --web | --backup)
      (($# >= 2)) || usage
      name=MJK_${1#--}_IMAGE
      name=${name^^}
      [[ -z ${given[$name]:-} ]] || usage
      given[$name]=$2
      explicit=1
      shift 2
      ;;
    *) usage ;;
  esac
done

valid_ref() { [[ $1 =~ ^[a-z0-9][a-z0-9._/:-]*(@sha256:[0-9a-f]{64})?$ && ${#1} -le 255 ]]; }

# A Docker registry host: a first path component with a dot or a colon (or localhost), and a slash.
has_registry() {
  local first=${1%%/*}
  [[ $1 == */* && ( $first == *.* || $first == *:* || $first == localhost ) ]]
}

# The repository of a ref: no tag, no digest.
repo_of() {
  local r=${1%%@*}
  [[ ${r##*/} != *:* ]] || r=${r%:*}
  printf '%s' "$r"
}

env_get() { # file key -> the last value of key= in the file, or nothing
  local value
  value=$(sed -n "s/^$2=//p" "$1" 2>/dev/null | tail -n 1) || true
  printf '%s' "$value"
}

for name in "${!given[@]}"; do
  valid_ref "${given[$name]}" || die "the ref for $name is not a valid image reference" 64
  if [[ -z $ROOT ]]; then
    has_registry "${given[$name]}" || die "the ref for $name has no registry host" 64
  fi
done

# --- config, lock, firewall --------------------------------------------------------------------------
[[ -f $COMPOSE && -f $MJK_ENV ]] || die "config_missing: $COMPOSE or $MJK_ENV" 78
# The same mjk.env rules as mjk-install (owner, mode, allowed keys), checked again before every deploy:
# an edit after the last install must not reach the containers. One implementation: mjk-envcheck.
ENVCHECK=$ROOT/usr/local/bin/mjk-envcheck
[[ -x $ENVCHECK ]] || die "config_missing: $ENVCHECK (run mjk-install)" 78
"$ENVCHECK" "$MJK_ENV" || die "config_invalid: mjk.env refused (the line above names the key or line, never a value)" 78
domain=$(env_get "$MJK_ENV" MJK_DOMAIN)
domain=${domain//\"/}
[[ $domain =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] || die "config_invalid: MJK_DOMAIN in mjk.env" 78
[[ -d $STATE ]] || die "config_missing: $STATE (run mjk-install)" 78

dc() { # <env file> <compose arguments...>
  local envfile=$1
  shift
  docker compose -p mjk -f "$COMPOSE" ${OVERRIDE:+-f "$OVERRIDE"} --env-file "$envfile" "$@"
}

# The lock lives in /run/mjk, root:root 0700 (created at boot by /etc/tmpfiles.d/mjk.conf), never in
# the world-writable /run/lock, where any local user could create and hold the file first.
lockdir_ok() {
  if [[ ! -e $LOCKDIR ]]; then
    mkdir -m 0700 -- "$LOCKDIR" 2>/dev/null || return 1
  fi
  [[ -d $LOCKDIR && ! -L $LOCKDIR && $(stat -c '%u:%a' "$LOCKDIR") == 0:700 ]]
}
lockdir_ok || die "lock_unusable: $LOCKDIR must be a root:root 0700 directory"
{ exec 9>"$LOCKFILE"; } 2>/dev/null || die "lock_unusable: cannot open $LOCKFILE"
if ! flock -x -n 9; then
  log "busy: another deploy, tick or backup holds the lock; nothing done"
  exit 0
fi

table_loaded() { "$NFT" list table inet mjk >/dev/null 2>&1; }

require_table() { table_loaded || die "firewall_missing: table inet mjk is not loaded; no deploy (mjk-tick reloads it)"; }
require_table
# Before each later compose step: the table, and no fail-closed stop by mjk-tick since this run began.
require_firewall() {
  require_table
  [[ ! -e $MARKER ]] || die "firewall_stopped: mjk-tick stopped the stack during this deploy; nothing started"
}

# The sha256 of the compose file(s) as this run uses them (the override exists only under MJK_ROOT).
compose_sha=$(cat "$COMPOSE" ${OVERRIDE:+"$OVERRIDE"} | sha256sum | cut -d ' ' -f 1)
[[ $compose_sha =~ ^[0-9a-f]{64}$ ]] || die "config_invalid: cannot hash $COMPOSE" 78

pair_line() { printf '%s %s %s %s' "${1:-}" "${2:-}" "${3:-}" "${4:-}"; }
pair_of() { # file -> "<server> <web> <backup> <compose sha256>"
  pair_line "$(env_get "$1" MJK_SERVER_IMAGE)" "$(env_get "$1" MJK_WEB_IMAGE)" "$(env_get "$1" MJK_BACKUP_IMAGE)" \
    "$(env_get "$1" MJK_COMPOSE_SHA256)"
}

write_env() { # file server web backup
  local tmp=$1.tmp
  printf 'MJK_SERVER_IMAGE=%s\nMJK_WEB_IMAGE=%s\nMJK_BACKUP_IMAGE=%s\nMJK_COMPOSE_SHA256=%s\n' "$2" "$3" "$4" "$compose_sha" >"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$1"
}

# Compose's error output of one step: a 0600 file in the unit's private /tmp, logged on a failure.
ERRLOG=$(mktemp "${TMPDIR:-/tmp}/mjk-update.XXXXXX")
trap 'rm -f "$ERRLOG"' EXIT
log_compose_error() {
  local line
  while IFS= read -r line; do
    line=${line//[^[:print:]]/}
    log "compose: ${line:0:300}"
  done < <(tail -n 5 "$ERRLOG")
}

# Every daemon service of the compose file has one container, running and healthy.
# Returns 0 when all are, 1 on a bad state (exited, restarting, unhealthy, missing at the deadline).
wait_healthy() { # <env file> <seconds>
  local envfile=$1 deadline=$((SECONDS + $2)) svc id status health pending
  local -a services
  mapfile -t services < <(dc "$envfile" config --services)
  ((${#services[@]} > 0)) || return 1
  while :; do
    pending=0
    for svc in "${services[@]}"; do
      id=$(docker ps -a -q --filter label=com.docker.compose.project=mjk \
        --filter "label=com.docker.compose.service=$svc" --filter label=com.docker.compose.oneoff=False | head -n 1)
      if [[ -z $id ]]; then
        pending=1
        continue
      fi
      status=$(docker inspect -f '{{.State.Status}}' "$id")
      health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$id")
      case $status/$health in
        running/healthy) ;;
        running/starting | created/*) pending=1 ;;
        *)
          log "not healthy: $svc is $status/$health"
          return 1
          ;;
      esac
    done
    ((pending == 0)) && return 0
    if ((SECONDS >= deadline)); then
      log "not healthy within $2 s"
      return 1
    fi
    sleep 2
  done
}

# Status code of one GET through the published port, with the public Host.
http_code() { # <path>
  curl -sS -m 10 -o /dev/null -w '%{http_code}' -H "Host: $domain" "http://127.0.0.1:$SMOKE_PORT$1" || true
}

smoke_test() {
  local code slug listing
  code=$(http_code /api/v1/healthz)
  [[ $code == 200 ]] || { log "smoke test failed: /api/v1/healthz answered $code"; return 1; }
  code=$(http_code /)
  [[ $code == 200 ]] || { log "smoke test failed: / answered $code"; return 1; }
  code=$(http_code /musea)
  [[ $code == 200 ]] || { log "smoke test failed: /musea answered $code"; return 1; }
  # One museum page, when the catalogue has one (it is empty until the first sync).
  listing=$(curl -sS -m 10 -H "Host: $domain" "http://127.0.0.1:$SMOKE_PORT/api/v1/museums?limit=1" || true)
  slug=$(jq -r '.items[0].slug // empty' <<<"$listing" 2>/dev/null || true)
  if [[ $slug =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    code=$(http_code "/musea/$slug")
    [[ $code == 200 ]] || { log "smoke test failed: a museum page answered $code"; return 1; }
  fi
  log "smoke test passed"
}

# --- an earlier fail-closed stop (A§17.7) -------------------------------------------------------------
if [[ -e $MARKER ]]; then
  if [[ -f $CURRENT ]]; then
    log "firewall-stopped marker present and the table is loaded: starting current.env again"
    timeout 600 docker compose -p mjk -f "$COMPOSE" ${OVERRIDE:+-f "$OVERRIDE"} --env-file "$CURRENT" \
      up -d --remove-orphans >/dev/null 2>"$ERRLOG" || { log_compose_error; die "could not start current.env again"; }
    rm -f "$MARKER"
  else
    rm -f "$MARKER"
  fi
fi

# --- the desired images ------------------------------------------------------------------------------
declare -A want=() pinned=() revision=()
for name in "${VARS[@]}"; do
  if [[ -n ${given[$name]:-} ]]; then
    want[$name]=${given[$name]}
  elif ((explicit)) && [[ -n $(env_get "$CURRENT" "$name") ]]; then
    want[$name]=$(env_get "$CURRENT" "$name")
  else
    case $name in
      MJK_SERVER_IMAGE) want[$name]=$REPO_PREFIX/mjk-server:main ;;
      MJK_WEB_IMAGE) want[$name]=$REPO_PREFIX/mjk-web:main ;;
      MJK_BACKUP_IMAGE) want[$name]=$REPO_PREFIX/mjk-backup:main ;;
    esac
  fi
done

pin() { # <ref> -> prints the recorded ref (by digest when the ref has a registry host)
  local ref=$1 repo digest
  if has_registry "$ref"; then
    timeout 300 docker pull -q "$ref" >/dev/null 2>&1 || return 1
    if [[ $ref == *@sha256:* ]]; then
      printf '%s' "$ref"
      return 0
    fi
    repo=$(repo_of "$ref")
    digest=$(docker image inspect -f '{{range .RepoDigests}}{{println .}}{{end}}' "$ref" | grep -F -m 1 "$repo@sha256:") || return 1
    printf '%s' "$digest"
  else
    docker image inspect "$ref" >/dev/null 2>&1 || return 1
    printf '%s' "$ref"
  fi
}

for name in "${VARS[@]}"; do
  pinned[$name]=$(pin "${want[$name]}") || die "pull_failed: $name ${want[$name]}"
  revision[$name]=$(docker image inspect -f "{{index .Config.Labels \"$REVISION_LABEL\"}}" "${pinned[$name]}" 2>/dev/null || true)
  log "$name ${pinned[$name]} revision ${revision[$name]:-none}"
done

if ((!explicit)); then
  for name in "${VARS[@]}"; do
    [[ -n ${revision[$name]} ]] || die "no_revision_label: $name has no $REVISION_LABEL; not deploying"
  done
  if [[ ${revision[MJK_SERVER_IMAGE]} == "${revision[MJK_WEB_IMAGE]}" && ${revision[MJK_SERVER_IMAGE]} == "${revision[MJK_BACKUP_IMAGE]}" ]]; then
    :
  else
    log "waiting: the images' revision labels differ (a release is still being pushed)"
    exit 0
  fi
fi

desired=$(pair_line "${pinned[MJK_SERVER_IMAGE]}" "${pinned[MJK_WEB_IMAGE]}" "${pinned[MJK_BACKUP_IMAGE]}" "$compose_sha")
if [[ -f $CURRENT && $desired == "$(pair_of "$CURRENT")" ]]; then
  log "up to date: the digests and the compose file equal current.env"
  exit 0
fi
if [[ -f $CURRENT && $(pair_line "${pinned[MJK_SERVER_IMAGE]}" "${pinned[MJK_WEB_IMAGE]}" "${pinned[MJK_BACKUP_IMAGE]}" "$(env_get "$CURRENT" MJK_COMPOSE_SHA256)") == "$(pair_of "$CURRENT")" ]]; then
  log "compose file changed since current.env (sha256 $compose_sha): deploying the same images with it"
fi
if ((!explicit)) && [[ -f $FAILED && $desired == "$(pair_of "$FAILED")" ]]; then
  die "REFUSED: this set of images failed before (failed.env); remove $FAILED to retry"
fi

# --- deploy ------------------------------------------------------------------------------------------
write_env "$NEXT" "${pinned[MJK_SERVER_IMAGE]}" "${pinned[MJK_WEB_IMAGE]}" "${pinned[MJK_BACKUP_IMAGE]}"
trap 'rm -f "$NEXT" "$NEXT.tmp" "$ERRLOG"' EXIT

fail_deploy() { # <reason code>
  log "deploy FAILED: $1"
  write_env "$FAILED" "${pinned[MJK_SERVER_IMAGE]}" "${pinned[MJK_WEB_IMAGE]}" "${pinned[MJK_BACKUP_IMAGE]}"
  require_firewall
  if [[ -f $CURRENT ]]; then
    log "rolling back to the images of current.env"
    if timeout 600 docker compose -p mjk -f "$COMPOSE" ${OVERRIDE:+-f "$OVERRIDE"} --env-file "$CURRENT" \
      up -d --remove-orphans >/dev/null 2>"$ERRLOG" && wait_healthy "$CURRENT" "$WAIT_SECONDS"; then
      log "rollback done: the previous images are healthy"
    else
      log_compose_error
      log "rollback FAILED: the previous images are not healthy; mjk-tick restarts what is unhealthy"
    fi
  else
    log "no current.env to return to: stopping the stack"
    timeout 300 docker compose -p mjk -f "$COMPOSE" ${OVERRIDE:+-f "$OVERRIDE"} --env-file "$NEXT" \
      down --remove-orphans >/dev/null 2>&1 || true
  fi
  exit 1
}

log "migrating"
require_firewall
timeout 300 docker compose -p mjk -f "$COMPOSE" ${OVERRIDE:+-f "$OVERRIDE"} --env-file "$NEXT" \
  --profile jobs run --rm -T migrate >/dev/null 2>"$ERRLOG" || { log_compose_error; fail_deploy migrate_failed; }

log "bringing the stack up"
require_firewall
timeout 600 docker compose -p mjk -f "$COMPOSE" ${OVERRIDE:+-f "$OVERRIDE"} --env-file "$NEXT" \
  up -d --remove-orphans >/dev/null 2>"$ERRLOG" || { log_compose_error; fail_deploy up_failed; }

wait_healthy "$NEXT" "$WAIT_SECONDS" || fail_deploy not_healthy
smoke_test || fail_deploy smoke_failed

write_env "$CURRENT" "${pinned[MJK_SERVER_IMAGE]}" "${pinned[MJK_WEB_IMAGE]}" "${pinned[MJK_BACKUP_IMAGE]}"
rm -f "$FAILED"
log "deployed: ${pinned[MJK_SERVER_IMAGE]} ${pinned[MJK_WEB_IMAGE]} ${pinned[MJK_BACKUP_IMAGE]}"

# --- 7. old images -----------------------------------------------------------------------------------
# Only references of our own repositories, and never one of the images current.env runs. `docker rmi
# <ref>` removes the reference, and the image with its last one; an image still in use stays.
declare -A keep=()
for name in "${VARS[@]}"; do
  id=$(docker image inspect -f '{{.Id}}' "${pinned[$name]}" 2>/dev/null) && keep[$id]=1
done
removed=0
while read -r repo tag digest id; do
  [[ -n $id && -z ${keep[$id]:-} ]] || continue
  if [[ $tag != "<none>" ]]; then
    ref=$repo:$tag
  elif [[ $digest == sha256:* ]]; then
    ref=$repo@$digest
  else
    continue
  fi
  if docker rmi "$ref" >/dev/null 2>&1; then removed=$((removed + 1)); fi
done < <(docker image ls --no-trunc --digests --filter "reference=$OWN_IMAGES" \
  --format '{{.Repository}} {{.Tag}} {{.Digest}} {{.ID}}' 2>/dev/null || true)
log "old images: $removed reference(s) of $OWN_IMAGES removed"
